# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# design reference only — a local mirror of naturalselection.so (third-party
# minified bundles + licensed fonts). Never shipped, never committed.
/natural-selection/

# stray working assets at repo root (canonical icons live in public/ + src/app/)
/favicon.svg
/favoriteicon.svg

# typescript
*.tsbuildinfo
next-env.d.ts
